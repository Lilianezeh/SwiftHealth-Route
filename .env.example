# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=swifthealth
POSTGRES_PASSWORD=swifthealth
POSTGRES_DB=swifthealth
DATABASE_URL=postgresql+psycopg://swifthealth:swifthealth@db:5432/swifthealth
# Separate database for pytest, run inside the backend container (host is db). Never the real database.
TEST_DATABASE_URL=postgresql+psycopg://swifthealth:swifthealth@db:5432/swifthealth_test
# "development" allows the built-in dev JWT secret. Any other value (production on Render) makes the app refuse to
# start unless JWT_SECRET is set, is not the default, and is at least 32 bytes.
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
# Keys the hash that counts different reporters (FR-22). Leave it blank in development: the app then uses a public
# development value. Outside development it must be set, different from JWT_SECRET, and at least 32 bytes.
REPORTER_KEY_SECRET=
# Production (set in the Render dashboard, see render.yaml): the Netlify address, https, no trailing slash.
# Several origins are separated by commas.
CORS_ORIGINS=http://localhost:3000
# How many proxies in front of the API add to X-Forwarded-For. On Render, count it from a real request.
TRUSTED_PROXY_COUNT=1
# Test-mode keys only
PAYSTACK_SECRET_KEY=sk_test_xxx
# Where Paystack sends a provider back after paying. Leave empty to use the first CORS_ORIGINS address.
WEB_APP_URL=
CLOUDINARY_URL=cloudinary://key:secret@cloud_name
# The name of an upload preset made in the Cloudinary account (images only, at most 5 MB). Empty: none is sent.
CLOUDINARY_UPLOAD_PRESET=
RESEND_API_KEY=re_xxx
# The sender of staff emails (FR-22 alerts): an address on a domain verified in Resend. With no key or no sender nothing is sent.
RESEND_FROM_EMAIL=
# Termii has no sandbox. Leave TERMII_API_KEY empty locally: the login code is then logged to the API console.
# Real sending needs a live account with the DND route activated and an approved sender ID.
TERMII_API_KEY=
# Your account's base URL, from the Termii dashboard (Settings, API token tab). Needed only with a key.
TERMII_BASE_URL=
TERMII_SENDER_ID=SwiftHealth
# "dnd" delivers to Do-Not-Disturb numbers and needs the DND route activated; "generic" is for promotions only.
TERMII_CHANNEL=dnd
FEATURED_PRICE_NAIRA=5000.00
# Demo listings (production check, see seed/demo_listings.py). Only the exact text "true" turns one on. Locally
# you can leave both false: run `docker compose exec -e SEED_DEMO_LISTINGS=true backend python -m seed.demo_listings`.
SEED_DEMO_LISTINGS=false
REMOVE_DEMO_LISTINGS=false
# Web
# Production (set in the Netlify dashboard with the "Builds" scope, see netlify.toml): the Render address, https.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Used by the web server inside Docker to reach the API. Leave it unset on Netlify: the public address is used.
API_URL_INTERNAL=http://backend:8000

SEED_VERIFIER_PASSWORD=
SEED_EDITOR_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_PROVIDER_PASSWORD=
