{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.local)", "Edit(./.env)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-on-edit.sh" }
        ]
      }
    ]
  }
}
